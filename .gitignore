# NASA PCoE battery data is INTENTIONALLY tracked in this copy of the repo
# (data/nasa_mat/, ~122 MB) so the project is fully self-contained for
# review. Re-add "data/nasa_mat/" and "*.mat" here if you'd rather keep the
# GitHub repo lean and host the data elsewhere — see data/README.md.
data/nasa_cache.pkl

# SUMO intermediates (regenerate with sumo/generate_traces.sh)
sumo/*.fcd.xml
sumo/*.trips.xml
sumo/*.rou.xml
sumo/*.rou.alt.xml
sumo/sub.net.xml
sumo/hwy.net.xml

# iFogSim2 itself is a separate MIT-licensed project — not vendored here.
# See java/README.md for how to apply this package to a clone.
iFogSim2/
out/
*.class

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/
